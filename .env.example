# Copy to backend/.env (or export) — every variable is optional; defaults work for a laptop demo.

# --- persistence (leave unset for in-memory mode) ------------------------------------------------
# NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
# NEXUS_REDIS_URL=redis://localhost:6379/0

# --- local LLM (Ollama). The platform works fully without it (deterministic planner fallback). -----
NEXUS_LLM_ENABLED=true
NEXUS_OLLAMA_URL=http://localhost:11434
NEXUS_LLM_MODEL=qwen2.5:7b
NEXUS_LLM_FALLBACK_MODEL=qwen2.5:3b    # used automatically if the primary model cannot be loaded (low memory)
NEXUS_LLM_TIMEOUT_S=90

# --- simulation ---------------------------------------------------------------------------------
NEXUS_DEFAULT_SCALE=small          # tiny | small | medium | large
NEXUS_DEFAULT_SEED=42
NEXUS_LIVE_TICKS_PER_SECOND=10

# --- agents -------------------------------------------------------------------------------------
NEXUS_CANDIDATE_PLANS=8
NEXUS_SIM_HORIZON_TICKS=5400       # 90 simulated minutes
NEXUS_AUTO_APPROVE_MAX_RISK=LOW
NEXUS_AUTO_APPROVE_MIN_GAIN=0.02

# --- observability ------------------------------------------------------------------------------
NEXUS_PROMETHEUS_ENABLED=true
NEXUS_OTEL_ENABLED=false
# NEXUS_OTEL_ENDPOINT=http://localhost:4317
NEXUS_LOG_JSON=false
NEXUS_LOG_LEVEL=INFO

# --- docker compose host ports (override when 8000/3000 are taken by another stack) ------------
# NEXUS_API_PORT=8010
# NEXUS_UI_PORT=3010
# NEXUS_GRAFANA_PORT=3011
# NEXUS_PROM_PORT=9091
# NEXUS_PG_PORT=5433
# NEXUS_REDIS_PORT=6380
