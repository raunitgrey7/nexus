{
  "title": "NEXUS · Live Twin",
  "uid": "nexus-live",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["nexus", "digital-twin"],
  "panels": [
    { "id": 1, "type": "stat", "title": "Projected SLA breach", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "nexus_sla_breach_projected", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.12 }] } }, "overrides": [] } },
    { "id": 2, "type": "stat", "title": "Open orders", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 }, "targets": [{ "expr": "nexus_orders_open", "refId": "A" }] },
    { "id": 3, "type": "stat", "title": "Throughput / h", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 }, "targets": [{ "expr": "nexus_throughput_per_hour", "refId": "A" }] },
    { "id": 4, "type": "stat", "title": "Robot utilization", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 }, "targets": [{ "expr": "nexus_robot_utilization", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] } },
    { "id": 5, "type": "stat", "title": "Robots operational", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 }, "targets": [{ "expr": "nexus_robots_operational", "refId": "A" }, { "expr": "nexus_robots_total", "refId": "B" }] },
    { "id": 6, "type": "stat", "title": "Sim tick", "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 }, "targets": [{ "expr": "nexus_sim_tick", "refId": "A" }] },
    { "id": 7, "type": "timeseries", "title": "SLA breach & congestion", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "nexus_sla_breach_projected", "legendFormat": "SLA breach (projected)", "refId": "A" }, { "expr": "nexus_congestion_index", "legendFormat": "congestion index", "refId": "B" }] },
    { "id": 8, "type": "timeseries", "title": "Orders open / pending", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "nexus_orders_open", "legendFormat": "open", "refId": "A" }, { "expr": "nexus_orders_pending", "legendFormat": "pending", "refId": "B" }] },
    { "id": 9, "type": "timeseries", "title": "Zone occupancy", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "nexus_zone_occupancy", "legendFormat": "{{zone}}", "refId": "A" }] },
    { "id": 10, "type": "timeseries", "title": "Events / s by type", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (type) (rate(nexus_events_total[1m]))", "legendFormat": "{{type}}", "refId": "A" }] },
    { "id": 11, "type": "timeseries", "title": "Decision pipeline latency (p50 / p95)", "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.5, sum(rate(nexus_planning_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" }, { "expr": "histogram_quantile(0.95, sum(rate(nexus_planning_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 12, "type": "timeseries", "title": "Engine step duration (p95)", "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(nexus_step_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95 step", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 13, "type": "stat", "title": "Decisions", "gridPos": { "x": 0, "y": 28, "w": 6, "h": 4 }, "targets": [{ "expr": "sum by (status) (nexus_decisions_total)", "legendFormat": "{{status}}", "refId": "A" }] },
    { "id": 14, "type": "stat", "title": "Simulations run", "gridPos": { "x": 6, "y": 28, "w": 6, "h": 4 }, "targets": [{ "expr": "sum by (kind) (nexus_simulations_total)", "legendFormat": "{{kind}}", "refId": "A" }] },
    { "id": 15, "type": "stat", "title": "Avg fulfillment (min)", "gridPos": { "x": 12, "y": 28, "w": 6, "h": 4 }, "targets": [{ "expr": "nexus_avg_fulfillment_minutes", "refId": "A" }] },
    { "id": 16, "type": "stat", "title": "Ticks / s", "gridPos": { "x": 18, "y": 28, "w": 6, "h": 4 }, "targets": [{ "expr": "nexus_sim_ticks_per_second", "refId": "A" }] }
  ]
}
